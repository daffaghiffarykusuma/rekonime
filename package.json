{
  "name": "rekonime",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node node_modules/vite/bin/vite.js build && node tools/generate-version.js && node tools/copy-static.js",
    "build:verify": "npm run build && npm run check:build-clean && npm run check:entrypoints",
    "check:repo-hygiene": "node tools/check-repo-hygiene.js",
    "check:coverage-thresholds": "node tools/check-coverage-thresholds.js",
    "check:outdated-budget": "node tools/check-outdated-budget.js",
    "check:unsafe-patterns": "node tools/check-unsafe-patterns.js",
    "check:security-headers": "node tools/check-security-headers.js",
    "check:security": "npm audit && npm run check:outdated-budget && npm run check:unsafe-patterns && npm run check:security-headers",
    "check:quick": "npm run test:unit && npm run test:integration && npm run data:validate",
    "hooks:install": "node tools/install-hooks.js",
    "lh:compare": "node tools/compare-lighthouse.js",
    "preview": "vite preview",
    "test": "node --test --import ./test/setup.js \"test/**/*.test.js\"",
    "test:unit": "node --test --import ./test/setup.js \"test/unit/**/*.test.js\"",
    "test:unit:watch": "node --watch --test --import ./test/setup.js \"test/unit/**/*.test.js\"",
    "test:integration": "node --test --import ./test/setup.js \"test/integration/**/*.test.js\"",
    "test:runtime": "node --test --import ./test/setup.js \"test/unit/watchlist*.test.js\" \"test/unit/reviews.test.js\" \"test/integration/app-*.test.js\"",
    "test:services": "node --test --import ./test/setup.js \"test/unit/*service*.test.js\" \"test/unit/api-client.test.js\" \"test/unit/cache-manager.test.js\" \"test/unit/schema-validator.test.js\"",
    "test:scraper": "node tools/run-scraper-tests.js",
    "test:tools": "node --test --import ./test/setup.js \"test/unit/pipeline-schema-validator.test.js\" \"test/unit/integrity-checker.test.js\" \"test/unit/embedded-data.test.js\" \"test/unit/quality-reporter.test.js\" \"test/integration/build-catalogs.test.js\" \"test/integration/validate-data.test.js\"",
    "test:coverage": "c8 --reporter=html --reporter=text --reporter=json-summary node --test --import ./test/setup.js \"test/**/*.test.js\"",
    "test:e2e": "playwright test",
    "check:build-clean": "node tools/check-build-clean.js",
    "data:regenerate": "node tools/regenerate-data.js",
    "data:refresh-scores": "node tools/refresh-scores.js",
    "data:validate": "node tools/validate-data.js --enforce-baseline --baseline tools/validation-baseline.json",
    "data:validate:strict": "node tools/validate-data.js",
    "check:entrypoints": "node tools/check-entrypoint-dedup.js",
    "data:backup": "node tools/deploy-data.js backup",
    "data:rollback": "node tools/deploy-data.js rollback"
  },
  "overrides": {
    "rollup": "^4.59.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "c8": "^11.0.0",
    "jsdom": "^25.0.1",
    "vite": "^7.3.1"
  }
}
