{
  "name": "rekonime",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node node_modules/vite/bin/vite.js build && node tools/generate-version.js && node tools/copy-static.js",
    "build:verify": "npm run build && npm run check:build-clean && npm run check:entrypoints",
    "lh:compare": "node tools/compare-lighthouse.js",
    "preview": "vite preview",
    "test": "node --test --import ./test/setup.js \"test/**/*.test.js\"",
    "test:unit": "node --test --import ./test/setup.js \"test/unit/**/*.test.js\"",
    "test:integration": "node --test --import ./test/setup.js \"test/integration/**/*.test.js\"",
    "test:coverage": "c8 --reporter=html --reporter=text node --test --import ./test/setup.js \"test/**/*.test.js\"",
    "test:e2e": "playwright test",
    "check:build-clean": "node tools/check-build-clean.js",
    "data:regenerate": "node tools/regenerate-data.js",
    "data:validate": "node tools/validate-data.js",
    "check:entrypoints": "node tools/check-entrypoint-dedup.js",
    "data:backup": "node tools/deploy-data.js backup",
    "data:rollback": "node tools/deploy-data.js rollback"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "c8": "^10.1.2",
    "jsdom": "^25.0.1",
    "vite": "^7.3.1"
  }
}
