{
  "name": "rekonime",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node node_modules/vite/bin/vite.js build && node tools/generate-version.js && node tools/copy-static.js",
    "build:verify": "bun run build && bun run check:build-clean && bun run check:dist-assets && bun run check:runtime-preview && bun run check:dist-size",
    "typecheck": "bunx tsc --noEmit",
    "check:repo-hygiene": "node tools/check-repo-hygiene.js",
    "check:coverage-thresholds": "node tools/check-coverage-thresholds.js",
    "check:outdated-budget": "node tools/check-outdated-budget.js",
    "check:unsafe-patterns": "node tools/check-unsafe-patterns.js",
    "check:security-headers": "node tools/check-security-headers.js",
    "check:dist-assets": "node tools/check-dist-assets.js",
    "check:runtime-preview": "node tools/check-runtime-preview.js",
    "check:dist-size": "node tools/check-dist-size-budget.js",
    "check:security": "bun audit && bun run check:outdated-budget && bun run check:unsafe-patterns && bun run check:security-headers",
    "check:quick": "bun run test:unit && bun run test:integration && bun run data:validate",
    "hooks:install": "node tools/install-hooks.js",
    "lh:compare": "node tools/compare-lighthouse.js",
    "preview": "vite preview",
    "test": "bun test --preload ./test/setup.js test/unit test/integration test/contracts test/recommendations.test.js test/stats.test.js",
    "test:unit": "bun test --preload ./test/setup.js test/unit",
    "test:unit:watch": "bun test --watch --preload ./test/setup.js test/unit",
    "test:integration": "bun test --preload ./test/setup.js test/integration",
    "test:runtime": "bun test --preload ./test/setup.js test/unit/watchlist test/unit/reviews.test.js test/integration/app-",
    "test:services": "bun test --preload ./test/setup.js test/unit/catalog- test/unit/cache-manager.test.js test/unit/schema-validator.test.js test/unit/reviews.test.js",
    "test:golden": "bun tools/run-python.js tools/python_golden_harness.py",
    "test:scraper": "bun tools/run-scraper-tests.js",
    "test:tools": "bun test --preload ./test/setup.js test/unit/python-",
    "test:coverage": "c8 --reporter=html --reporter=text --reporter=json-summary node --test --import ./test/setup.js \"test/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test:e2e:prod": "bun run build && playwright test --config playwright.prod.config.js",
    "check:build-clean": "node tools/check-build-clean.js",
    "data:build": "bun tools/run-python.js tools/build_catalogs.py",
    "data:regenerate": "bun tools/run-python.js tools/regenerate_data.py",
    "data:refresh-scores": "node tools/refresh-scores.js",
    "data:refresh-season-scores": "bun tools/refresh-season-scores.js",
    "data:validate": "bun tools/run-python.js tools/validate_data.py --enforce-baseline --baseline tools/validation-baseline.json",
    "data:validate:strict": "bun tools/run-python.js tools/validate_data.py",
    "data:backup": "bun tools/run-python.js tools/deploy_data.py backup",
    "data:rollback": "bun tools/run-python.js tools/deploy_data.py rollback"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "picomatch": "^4.0.5",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bun": "^1.3.14",
    "c8": "^12.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
